# =====================================================================
# FINIKO API v2 — variables d'environnement
# Copie locale : `cp .env.example .env`
# Production Vercel : renseigner ces variables dans le tableau de bord
# (Project Settings > Environment Variables), JAMAIS dans le dépôt Git.
# =====================================================================

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
SERVICE_VERSION=2.0.0-alpha.0

# --- Base de données -------------------------------------------------
# Dev local : MongoDB sur le poste.
# Production Vercel : URI MongoDB Atlas (mongodb+srv://user:pass@cluster/finiko).
MONGODB_URI=mongodb://127.0.0.1:27017/finiko_v2

# --- CORS -------------------------------------------------------------
# Origines autorisées (web). Les apps mobiles natives n'envoient pas
# d'header Origin : elles passent toujours. En prod web, lister les
# domaines du frontend, ou '*' pour tout autoriser.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# --- Auth / JWT --------------------------------------------------------
# OBLIGATOIRE en production : secret >= 32 caractères, aléatoire.
JWT_ACCESS_SECRET=change-me-finiko-access-secret-32-chars-min
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30

# --- OTP ---------------------------------------------------------------
# OBLIGATOIRE en production : poivre >= 16 caractères, aléatoire.
OTP_PEPPER=change-me-finiko-otp-pepper-16
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# Doit rester false en production (ne pas exposer les codes OTP).
OTP_EXPOSE_CODE=true
SMS_PROVIDER=console

# --- Argon2 (hash des mots de passe) ------------------------------------
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# --- Quotas packs -------------------------------------------------------
QUOTA_RESERVATION_TTL_MINUTES=20
