{
  "expo": {
    "name": "FINIKO",
    "slug": "finiko",
    "version": "2.0.0",
    "orientation": "portrait",
    "scheme": "finiko",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F9FAFB",
    "primaryColor": "#2563EB",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/0449895e-4b53-4496-8d2a-bae56f868727"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ml.finiko.app"
    },
    "android": {
      "package": "ml.finiko.app",
      "edgeToEdgeEnabled": true,
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "FINIKO utilise votre position pour choisir l’adresse de ramassage et de livraison sur la carte."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": "0449895e-4b53-4496-8d2a-bae56f868727"
      }
    },
    "owner": "cherifcoder"
  }
}
