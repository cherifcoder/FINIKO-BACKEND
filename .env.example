NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
SERVICE_VERSION=2.0.0-alpha.0

# MongoDB en replica set (transactions requises pour le moteur de quota)
MONGODB_URI=mongodb://localhost:27017/finiko?replicaSet=rs0&directConnection=true

# Origines autorisees pour le web (Expo Web). Les apps natives n'envoient pas d'Origin.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
