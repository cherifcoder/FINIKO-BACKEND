NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
SERVICE_VERSION=2.0.0-alpha.0

# MongoDB en replica set (transactions requises pour le moteur de quota)
MONGODB_URI=mongodb://localhost:27017/finiko?replicaSet=rs0&directConnection=true

# Origines autorisees pour le web (Expo Web). Les apps natives n'envoient pas d'Origin.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# ---------------------------------------------------------------------------
# Authentification
# ---------------------------------------------------------------------------
# Secret de signature des access tokens JWT (HS256). Minimum 32 caracteres.
# EN PRODUCTION : remplacer par un secret genere, jamais celui-ci.
JWT_ACCESS_SECRET=change-me-finiko-access-secret-32-chars-min
JWT_ACCESS_TTL_SECONDS=900

# Duree de vie du refresh token opaque (jours). Rotation a chaque usage.
REFRESH_TTL_DAYS=30

# Poivre HMAC des codes OTP (minimum 16 caracteres).
# EN PRODUCTION : remplacer par un secret genere, jamais celui-ci.
OTP_PEPPER=change-me-finiko-otp-pepper-16
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Hors production, renvoie le code OTP dans la reponse API pour les tests
# et l'affiche sur l'ecran de verification mobile. Doit valoir false en production.
OTP_EXPOSE_CODE=true

# Fournisseur SMS : "console" ecrit le code dans les logs de dev, "noop" n'envoie rien.
SMS_PROVIDER=console

# Cout Argon2id. Les valeurs de test sont reduites dans apps/api/vitest.config.ts.
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Duree de vie d'une reservation de quota avant liberation par le job (minutes).
QUOTA_RESERVATION_TTL_MINUTES=20
