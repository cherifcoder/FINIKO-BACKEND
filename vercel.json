{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "regions": ["fra1"],
  "functions": {
    "apps/api/api/index.ts": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "**/*.node"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/apps/api/api/index"
    }
  ]
}
